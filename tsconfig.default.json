{
  "$schema": "https://www.schemastore.org/tsconfig",
  "//": "Used by typescript-eslint for files that no tsconfig/jsconfig includes.",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  }
}
